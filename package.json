{
  "name": "sir-vscode",
  "displayName": "S.I.R Patches",
  "description": "Write and maintain structure-aware patches over upstream code: generate a .sirp patch from your edits, see where every hunk lands, and move between the patch and the code",
  "version": "0.0.1",
  "publisher": "danil-varakin",
  "license": "MIT",
  "galleryBanner": {
    "color": "#2f6b4f",
    "theme": "dark"
  },
  "homepage": "https://github.com/Danil-Varakin/S.I.R-VScodeExtension#readme",
  "bugs": {
    "url": "https://github.com/Danil-Varakin/S.I.R-VScodeExtension/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Danil-Varakin/S.I.R-VScodeExtension.git"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "patch",
    "patches",
    "upstream",
    "fork",
    "rebase",
    "tree-sitter",
    "chromium",
    "sir"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/sir.config.json",
    "onLanguage:sir"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "S.I.R spawns its core as a child process and measures patch paths from the .git directory, so it needs the files on a real file system."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Patches are generated and read. Until the workspace is trusted, a patch its sir.config.json sends outside the workspace is written only after you confirm, the sir.out setting of the workspace is ignored, and no sir.config.json is created.",
      "restrictedConfigurations": [
        "sir.out"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "sir.generate",
        "title": "Generate Patch",
        "category": "S.I.R",
        "icon": "$(diff-added)"
      },
      {
        "command": "sir.generateAgainstFile",
        "title": "Generate Patch Against File…",
        "category": "S.I.R"
      },
      {
        "command": "sir.newPatch",
        "title": "New S.I.R Patch",
        "category": "S.I.R"
      },
      {
        "command": "sir.continueGenerate",
        "title": "Continue Generate",
        "category": "S.I.R",
        "icon": "$(debug-continue)"
      },
      {
        "command": "sir.showBase",
        "title": "Show Base",
        "category": "S.I.R"
      },
      {
        "command": "sir.toggle",
        "title": "Go to the Other Side",
        "category": "S.I.R",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "sir.goToBaseline",
        "title": "Go to What the Hunk Replaces",
        "category": "S.I.R"
      },
      {
        "command": "sir.initConfig",
        "title": "Init Config",
        "category": "S.I.R"
      },
      {
        "command": "sir.showLog",
        "title": "Show Log",
        "category": "S.I.R"
      },
      {
        "command": "sir.apply",
        "title": "Apply Patch",
        "category": "S.I.R",
        "icon": "$(play)"
      },
      {
        "command": "sir.applyAll",
        "title": "Apply All Patches",
        "category": "S.I.R",
        "icon": "$(run-all)"
      },
      {
        "command": "sir.previewPatch",
        "title": "Preview Patch",
        "category": "S.I.R"
      },
      {
        "command": "sir.showEditsNotInPatch",
        "title": "Show Edits Not in Patch",
        "category": "S.I.R"
      },
      {
        "command": "sir.checkAll",
        "title": "Check All Patches",
        "category": "S.I.R",
        "icon": "$(checklist)"
      },
      {
        "command": "sir.copyReport",
        "title": "Copy Patch Report",
        "category": "S.I.R",
        "icon": "$(copy)"
      },
      {
        "command": "sir.openFailed",
        "title": "Open Failed Patches",
        "category": "S.I.R",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sir.repair",
        "title": "Repair Hunk",
        "category": "S.I.R"
      }
    ],
    "keybindings": [
      {
        "command": "sir.generate",
        "key": "alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && resourceScheme == file"
      },
      {
        "command": "sir.toggle",
        "key": "alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus && (resourceScheme == file || resourceScheme == sir-baseline)"
      },
      {
        "command": "sir.goToBaseline",
        "key": "alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus && (resourceScheme == file || resourceScheme == sir-baseline)"
      },
      {
        "command": "sir.apply",
        "key": "alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sir.generate",
          "when": "resourceScheme == file"
        },
        {
          "command": "sir.generateAgainstFile",
          "when": "resourceScheme == file"
        },
        {
          "command": "sir.newPatch",
          "when": "resourceScheme == file && editorLangId != sir"
        },
        {
          "command": "sir.continueGenerate",
          "when": "resourceScheme == untitled && editorLangId == sir"
        },
        {
          "command": "sir.showBase",
          "when": "resourceScheme == file"
        },
        {
          "command": "sir.toggle",
          "when": "resourceScheme == file || resourceScheme == sir-baseline"
        },
        {
          "command": "sir.goToBaseline",
          "when": "resourceScheme == file || resourceScheme == sir-baseline"
        },
        {
          "command": "sir.initConfig",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "sir.apply",
          "when": "resourceScheme == file"
        },
        {
          "command": "sir.applyAll",
          "when": "sir.active"
        },
        {
          "command": "sir.previewPatch",
          "when": "resourceScheme == file"
        },
        {
          "command": "sir.showEditsNotInPatch",
          "when": "resourceScheme == file && editorLangId != sir"
        },
        {
          "command": "sir.checkAll",
          "when": "sir.active"
        },
        {
          "command": "sir.copyReport",
          "when": "sir.active"
        },
        {
          "command": "sir.openFailed",
          "when": "sir.active"
        },
        {
          "command": "sir.repair",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "sir.generate",
          "when": "resourceScheme == file && editorLangId != sir && resourceExtname in sir.extensions",
          "group": "navigation@100"
        },
        {
          "command": "sir.apply",
          "when": "resourceScheme == file && editorLangId == sir",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "command": "sir.generate",
          "when": "resourceScheme == file && resourceExtname in sir.extensions",
          "group": "1_sir@1"
        },
        {
          "command": "sir.newPatch",
          "when": "resourceScheme == file && resourceExtname in sir.extensions",
          "group": "1_sir@2"
        }
      ],
      "explorer/context": [
        {
          "command": "sir.generate",
          "when": "!explorerResourceIsFolder && resourceExtname in sir.extensions",
          "group": "navigation@9"
        },
        {
          "command": "sir.newPatch",
          "when": "!explorerResourceIsFolder && resourceExtname in sir.extensions",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "sir.checkAll",
          "when": "view == sir.patches",
          "group": "navigation@1"
        },
        {
          "command": "sir.applyAll",
          "when": "view == sir.patches",
          "group": "navigation@2"
        },
        {
          "command": "sir.openFailed",
          "when": "view == sir.patches",
          "group": "navigation@3"
        },
        {
          "command": "sir.copyReport",
          "when": "view == sir.patches",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "sir.apply",
          "when": "view == sir.patches",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "S.I.R",
      "properties": {
        "sir.out": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Where patches go. A directory (or a path ending with a slash) receives `<file name>.sirp`; a file must be named `*.sirp`. With `upstream` set in `sir.config.json` it is the root of the patch tree. Config key: `generate.out`. Leave unset to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.language": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Force a language instead of deriving it from the file extension. Config key: `generate.language`. Leave unset to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.exact": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "markdownDescription": "Reproduce the file byte for byte instead of matching every line after normalization. Config key: `generate.exact`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.bridgeGap": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "Stitch edits separated by up to this many unchanged non-blank lines into a single hunk. Config key: `generate.bridgeGap`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.parents.min": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "Enclosing blocks every pattern carries. A hunk with no parent is not structural: drifting neighbours can land it in another function. Config key: `generate.parents.min`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.parents.max": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "enum": [
                "all"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "scope": "resource",
          "markdownDescription": "Cap on climbing up: at most this many enclosing blocks per pattern, or `\"all\"`. Config key: `generate.parents.max`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.parents.detail.base": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "Bracket levels spelled out in parent headers, counting from the outermost: `0` gives `foo( ... )`, `1` gives `foo(bar( ... ))`. Readability against drift-tolerance, never correctness. Config key: `generate.parents.detail.base`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.parents.required": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "markdownDescription": "Never fall back to a parentless pattern: fail instead of emitting an anchor that drift can move. Config key: `generate.parents.required`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.siblings.min": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "Neighbouring significant lines every pattern carries, per side. Config key: `generate.siblings.min`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.siblings.max": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "Cap of neighbouring significant lines per side. `0` forbids leaning on neighbours at all, keeping anchoring purely structural. Config key: `generate.siblings.max`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.siblings.detail.base": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "scope": "resource",
          "markdownDescription": "Same bracket baseline for neighbour anchors. Config key: `generate.siblings.detail.base`. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.base.head": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "scope": "resource",
          "markdownDescription": "Compare the buffer with this file as of the last commit of the current branch, instead of with the file as saved on disk. `false` compares with the saved file even when the project config names a git base. With `sir.base.branch` or `sir.base.commit` set it is implied. Config key: `generate.base.head` (config schema 2). The three `sir.base.*` settings name the base whole: any of them set replaces the config's `generate.base` entirely. Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.base.branch": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Compare with the file as of the last commit of this branch, local or remote-tracking (`main`, `origin/main`). Config key: `generate.base.branch` (config schema 2). Leave unset to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.base.commit": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Compare with the file as of this commit. Beside `sir.base.branch` it must be a commit that branch holds. Config key: `generate.base.commit` (config schema 2). Leave unset to let `sir.config.json` decide; setting it here overrides the project config for you only."
        },
        "sir.base.eol": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "repository",
            "worktree",
            null
          ],
          "default": null,
          "scope": "resource",
          "markdownDescription": "Line endings of a base read out of git: `repository` — as git stores the file; `worktree` — as the file on disk has them, for repositories with `core.autocrlf`. Applies with a git base named by `sir.base.head`, `sir.base.branch` or `sir.base.commit`. Config key: `generate.base.eol` (config schema 2). Leave unset (`null`) to let `sir.config.json` decide; setting it here overrides the project config for you only. When neither sets it, the editor reads with `worktree` — the buffer is compared as it is on disk — while the CLI keeps `repository`."
        }
      }
    },
    "languages": [
      {
        "id": "sir",
        "aliases": [
          "S.I.R Patch",
          "sir"
        ],
        "extensions": [
          ".sirp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sir",
        "scopeName": "text.sirp",
        "path": "./syntaxes/sir.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.objective-c": "objective-c",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.typescriptreact": "typescriptreact",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.kotlin": "kotlin",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.json5": "json5",
          "meta.embedded.block.toml": "toml",
          "meta.embedded.block.proto3": "proto3",
          "meta.embedded.block.webidl": "webidl",
          "meta.embedded.block.mojom": "mojom",
          "meta.embedded.block.plaintext": "plaintext"
        }
      }
    ],
    "snippets": [
      {
        "language": "sir",
        "path": "./snippets/sir.json"
      }
    ],
    "configurationDefaults": {
      "[sir]": {
        "files.trimTrailingWhitespace": false,
        "files.insertFinalNewline": false,
        "editor.formatOnSave": false,
        "editor.renderWhitespace": "trailing",
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    },
    "views": {
      "explorer": [
        {
          "id": "sir.patches",
          "name": "S.I.R Patches",
          "when": "sir.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sir.patches",
        "contents": "Check every patch of the workspace against the project base: what does not apply is listed here, in Problems and in red in the Explorer.\n[Check All Patches](command:sir.checkAll)"
      }
    ],
    "colors": [
      {
        "id": "sir.appliedPatchForeground",
        "description": "The label after a patch's header, and the patch's name in the Explorer, when the patch is in its code.",
        "defaults": {
          "dark": "#89d185",
          "light": "#388a34",
          "highContrast": "#89d185",
          "highContrastLight": "#388a34"
        }
      },
      {
        "id": "sir.appliedPatchBackground",
        "description": "Background of the label after a patch's header when the patch is in its code.",
        "defaults": {
          "dark": "#89d18526",
          "light": "#388a341f",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "sir.notAppliedPatchForeground",
        "description": "The label after a patch's header, and the patch's name in the Explorer, when the code is still its base.",
        "defaults": {
          "dark": "#3794ff",
          "light": "#1a85ff",
          "highContrast": "#3794ff",
          "highContrastLight": "#0f4a85"
        }
      },
      {
        "id": "sir.notAppliedPatchBackground",
        "description": "Background of the label after a patch's header when the code is still its base.",
        "defaults": {
          "dark": "#3794ff26",
          "light": "#1a85ff1f",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "sir.changedPatchForeground",
        "description": "The label after a patch's header, and the patch's name in the Explorer, when the code changed since the patch.",
        "defaults": {
          "dark": "sir.driftedHunkForeground",
          "light": "sir.driftedHunkForeground",
          "highContrast": "sir.driftedHunkForeground",
          "highContrastLight": "sir.driftedHunkForeground"
        }
      },
      {
        "id": "sir.changedPatchBackground",
        "description": "Background of the label after a patch's header when the code changed since the patch.",
        "defaults": {
          "dark": "sir.driftedHunkBackground",
          "light": "sir.driftedHunkBackground",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "sir.driftedHunkBackground",
        "description": "Background of a hunk whose text the code no longer holds.",
        "defaults": {
          "dark": "#cca70033",
          "light": "#cca70040",
          "highContrast": "#cca70066",
          "highContrastLight": "#cca70066"
        }
      },
      {
        "id": "sir.selectedHunkForeground",
        "description": "The frame, the scrollbar mark and the label of the hunk Go to What the Hunk Replaces marks in the diff «base ↔ base + patch».",
        "defaults": {
          "dark": "focusBorder",
          "light": "focusBorder",
          "highContrast": "contrastActiveBorder",
          "highContrastLight": "contrastActiveBorder"
        }
      },
      {
        "id": "sir.selectedHunkBackground",
        "description": "Background of the hunk Go to What the Hunk Replaces marks in the diff «base ↔ base + patch».",
        "defaults": {
          "dark": "#3794ff2e",
          "light": "#1a85ff24",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "sir.brokenHunkBackground",
        "description": "Background of a hunk that lands nowhere in the base.",
        "defaults": {
          "dark": "#f4877133",
          "light": "#e5141440",
          "highContrast": "#f4877166",
          "highContrastLight": "#e5141466"
        }
      },
      {
        "id": "sir.driftedHunkForeground",
        "description": "Mark after the header of a drifted hunk.",
        "defaults": {
          "dark": "#cca700",
          "light": "#bf8803",
          "highContrast": "#ffd700",
          "highContrastLight": "#bf8803"
        }
      },
      {
        "id": "sir.brokenHunkForeground",
        "description": "Mark after the header of a broken hunk.",
        "defaults": {
          "dark": "#f48771",
          "light": "#e51400",
          "highContrast": "#f48771",
          "highContrastLight": "#e51400"
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build-grammar.mjs && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "vscode:prepublish": "npm run build",
    "grammar": "node scripts/build-grammar.mjs",
    "package": "node scripts/package.mjs",
    "test:e2e": "npm run build && node scripts/build-e2e.mjs && vscode-test",
    "test:packaged": "node scripts/build-e2e.mjs && node scripts/test-packaged.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "test:mutation": "stryker run",
    "coverage": "node scripts/coverage.mjs"
  },
  "dependencies": {
    "sir": "https://github.com/Danil-Varakin/S.I.R/releases/download/v0.5.0/sir-0.5.0.tgz"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "c8": "^11.0.0",
    "esbuild": "^0.25.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "mocha": "^12.0.3",
    "typescript": "^5.7.0"
  }
}
